# ==============================================================================
# NEURAFORGE AI & BOTCAZA - ENVIRONMENT VARIABLES SPECIFICATION
# ==============================================================================
# Instrucciones: Copia este archivo a .env en local o configúralas en tu panel
# de Render.com / Cloud Run. NUNCA subas credenciales reales a GitHub.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE VARIABLES (REQUERIDAS / CRÍTICAS)
# ------------------------------------------------------------------------------

# [REQUERIDA] Gemini API Key para Agente de Datos Aptos y Diagnóstico de Errores.
# Obtén tu clave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# [REQUERIDA / OPCIONAL CON DEFAULT] URL del Fullnode oficial de Aptos.
# Default si está vacía: https://fullnode.mainnet.aptoslabs.com/v1
APTOS_NODE_URL="https://fullnode.mainnet.aptoslabs.com/v1"

# [REQUERIDA] Puerto de red donde escuchará el servidor Node.js / Python.
# Render.com e infraestructuras en contenedor asignan PORT automáticamente.
PORT=3000

# [REQUERIDA] Entorno de ejecución ('production' | 'development' | 'test')
NODE_ENV="production"

# ------------------------------------------------------------------------------
# 2. PUBLIC & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------

# [OPCIONAL / RECOMENDADO EN PRODUCCIÓN] URL canónica del despliegue público.
# Utilizado para Webhook de Telegram, CORS y enlaces absolutos de la Mini App.
APP_URL="https://go.botcaza.ai"

# [OPCIONAL] ID de editor de Google AdSense para monetización CPC.
# Default: pub-9493850506792206
ADSENSE_PUBLISHER_ID="pub-9493850506792206"

# [OPCIONAL] ID de Medición de Google Analytics 4.
# Default: G-24Q6GBQN75
GA4_MEASUREMENT_ID="G-24Q6GBQN75"

# ------------------------------------------------------------------------------
# 3. TELEGRAM BOT & MINI APP (OPCIONAL)
# ------------------------------------------------------------------------------

# [OPCIONAL] Token de tu bot de Telegram obtenido desde @BotFather.
# Requerido únicamente si deseas que el bot responda al webhook (/start, /wallet)
# y despache alertas automáticas a canales o usuarios.
TELEGRAM_BOT_TOKEN=""

# ------------------------------------------------------------------------------
# 4. META MARKETING & CONVERSIONS API (OPCIONAL)
# ------------------------------------------------------------------------------

# [OPCIONAL] Token de acceso de Graph API de Meta (WhatsApp Cloud / CAPI).
META_ACCESS_TOKEN=""

# [OPCIONAL] ID del número telefónico de WhatsApp Cloud API para notificaciones.
META_PHONE_NUMBER_ID=""

# [OPCIONAL] Token de verificación para el webhook de Meta Webhooks.
META_VERIFY_TOKEN=""

# [OPCIONAL] ID del Píxel de Meta para Conversions API (CAPI server-side).
META_PIXEL_ID=""

# [OPCIONAL] App Secret de Meta Developers.
META_APP_SECRET=""


